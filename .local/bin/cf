#!/usr/bin/sh

result=$(mktemp)
trap 'rm -f "$result"' EXIT

footclient --app-id=foot-fzf-config sh -c '
    {
        echo Projects/dotfiles/watching_files.txt
        awk "/^[[:space:]]*#/ { next } { print }" \
            "$HOME/Projects/dotfiles/watching_files.txt"
    } | fzf --height=100% --layout=reverse > "$1"
' sh "$result"

selected_file=$(cat "$result")

if [ -n "$selected_file" ]; then
    footclient -e "$EDITOR" "$HOME/$selected_file"
fi
