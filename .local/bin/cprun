#!/bin/bash

file="$1"
exe=$(mktemp)

trap 'rm -f "$exe"' EXIT

g++ -std=c++23 "$file" -DLOCAL -fsanitize=undefined,address -Wall -Wextra -Wshadow -fmax-errors=1 -O0 -o "$exe" || exit 1
echo "Compiled"

if (( $# == 1 )); then
    "$exe"
else
    for input in "${@:2}"; do
        printf '\n\033[1;34m===== %s =====\033[0m\n' "$input"
        "$exe" < "$input"
        echo
    done
fi
